# ==========================================
# Dboke Monorepo Environment Variables
# ==========================================

# --- Backend (Golang API) ---
PORT=8080
GIN_MODE=debug
# Master key used for AES-256 encryption (MUST be exactly 32 bytes/characters)
DBOKE_MASTER_KEY=your_32_character_master_key_here
# Frontend Origin for strict CORS Policy
CORS_ALLOWED_ORIGIN=http://localhost:3000

# --- Frontend (Next.js Web) ---
# Next.js specific env vars (must be prefixed with NEXT_PUBLIC_ for client access)
NEXT_PUBLIC_API_URL=http://localhost:8080
